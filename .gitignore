# Python virtual environment
venv/

# Python bytecode cache
__pycache__/
*.pyc

# PyInstaller build output (regenerated by build_linux.sh)
build/
dist/

# Packaging build artifacts (regenerated by the packaging scripts;
# includes downloaded appimagetool and the final .deb/.AppImage, which
# are large binaries that don't belong in git)
packaging/linux/build/
packaging/linux/output/

# Local user settings written at runtime, not part of the source
.mobcam/

# MacOs Build iggnore files 
packaging/macos/build/
packaging/macos/output/
packaging/macos/mobcam.iconset/
packaging/macos/mobcam.icnspackaging/windows/build/
packaging/windows/output/
packaging/windows/mobcam.ico
